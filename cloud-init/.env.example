# Copy to .env beside this file. Values are literal, one per line, without enclosing quotes.
# Leave empty to generate a unique Grafana admin password on first boot.
GF_SECURITY_ADMIN_PASSWORD=

# Set to 1 after filling in the SMTP credentials and a verified sender.
FRAY_SIGNUP_ENABLED=0
FRAY_EMAIL_HOST=in-v3.mailjet.com
FRAY_EMAIL_PORT=587
FRAY_EMAIL_USE_TLS=1
FRAY_EMAIL_USE_SSL=0
FRAY_EMAIL_USER=
FRAY_EMAIL_PASSWORD=
FRAY_EMAIL_FROM=
